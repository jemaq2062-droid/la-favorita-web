# Copiar a .env si utiliza un cargador de variables, o exportarlas en el sistema.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
ADMIN_PASSWORD=define-una-clave-larga-y-privada
# Una vez que Neon esté creado, activar PostgreSQL instalando pg (npm install)
# DATABASE_URL=postgresql://usuario:clave@host.neon.tech/base?sslmode=require
# APP_ORIGIN=https://tu-dominio.com
# COOKIE_SECURE=true
# Para un panel en otro dominio (opcional)
# ADMIN_ORIGIN=https://admin.ejemplo.com
# CROSS_SITE_ADMIN=true
# SESSION_SECRET=cadena-aleatoria-larga
# IA opcional para lectura de PDF e imágenes escolares (la API puede generar cargos)
# OPENAI_API_KEY=coloca-tu-clave-en-variables-de-entorno-no-en-el-front
# OPENAI_VISION_MODEL=gpt-4.1-mini

# Base comercial V6.1 (no coloca valores privados en Git)
# SEED_DEMO_PRODUCTS=true
# SAVE_QUOTE_HISTORY=false
# PGSSL=false  # SOLO al usar PostgreSQL local sin TLS; no usar en Neon

# Catálogo inicial para una instalación sin data/current.json
# INITIAL_CATALOG_FILE=data/catalog-bootstrap.json
